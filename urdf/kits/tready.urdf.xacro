  <xacro:output trans="-0.275 0 0.037" rot="3.1416 0 3.1416" parent="$(arg prefix)rigid_body_3" child="$(arg prefix)T2_J2_track/body" name="$(arg prefix)rigid_body_3_T2_J2_track"/>
