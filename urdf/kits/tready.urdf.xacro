<?xml version='1.0' encoding='UTF-8'?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" description="Tready" name="Tready">
  <xacro:arg name="prefix" default=""/>
  <!-- HEBI Tready Arm Kit -->
  <xacro:include filename="$(find hebi_description)/urdf/components/hebi.xacro"/>
  <xacro:rigid-body mass="10" mesh_path="file://$(find hebi_description)/meshes/A-2362-01.obj" mesh_rot="0 0 0" mesh_trans="0 0 0" name="$(arg prefix)rigid_body_1"/>
  <xacro:output rot="1.5708 -0.7854 3.1416" trans="0.2057 0.1400 -0.0408" parent="$(arg prefix)rigid_body_1" child="$(arg prefix)rigid_body_2" name="$(arg prefix)rigid_body_1_rigid_body_2"/>
  <xacro:rigid-body mass="0.01" name="$(arg prefix)rigid_body_2"/>
