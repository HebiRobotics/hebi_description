  <xacro:gripper name="$(arg prefix)end_effector_1"/>
  <xacro:output rot="-1.5708 -0.7854 -3.1416" trans="0.2057 -0.1400 -0.0408" parent="$(arg prefix)rigid_body_1" child="$(arg prefix)rigid_body_5" name="$(arg prefix)rigid_body_1_rigid_body_5"/>
